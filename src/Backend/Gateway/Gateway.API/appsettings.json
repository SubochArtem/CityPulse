{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "feedback": {
        "ClusterId": "feedback",
        "Order": 1,
        "Match": {
          "Path": "/api/v1/feedback/{**catch-all}"
        }
      },
      "admin-feedback": {
        "ClusterId": "feedback",
        "Order": 1,
        "Match": {
          "Path": "/api/v1/admin/feedback/{**catch-all}"
        }
      },
      "idea-feedback": {
        "ClusterId": "feedback",
        "Order": 1,
        "Match": {
          "Path": "/api/v1/ideas/{ideaId}/feedback"
        }
      },
      "admin-idea-feedback": {
        "ClusterId": "feedback",
        "Order": 1,
        "Match": {
          "Path": "/api/v1/admin/ideas/{ideaId}/feedback"
        }
      },
      "users": {
        "ClusterId": "users",
        "Order": 1,
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      },
      "auth0-webhook": {
        "ClusterId": "users",
        "Order": 1,
        "Match": {
          "Path": "/api/v1/auth0webhook"
        }
      },
      "polls": {
        "ClusterId": "polls",
        "Order": 100,
        "Match": {
          "Path": "/api/v1/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "users": {
        "Destinations": {
          "users": {
            "Address": "http://localhost:5087"
          }
        }
      },
      "polls": {
        "Destinations": {
          "polls": {
            "Address": "http://localhost:5215"
          }
        }
      },
      "feedback": {
        "Destinations": {
          "feedback": {
            "Address": "http://localhost:5167"
          }
        }
      }
    }
  }
}
