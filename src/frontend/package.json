{
  "name": "citypulse-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:api": "npx --yes openapi-typescript@7.13.0 ${API_BASE_URL:-http://localhost:8080}/swagger/users/swagger.json -o src/api/schema/users.ts && npx --yes openapi-typescript@7.13.0 ${API_BASE_URL:-http://localhost:8080}/swagger/polls/swagger.json -o src/api/schema/polls.ts && npx --yes openapi-typescript@7.13.0 ${API_BASE_URL:-http://localhost:8080}/swagger/feedback/swagger.json -o src/api/schema/feedback.ts"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.30.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.105.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.68.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.23.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
